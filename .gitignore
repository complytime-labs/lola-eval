# Generated config
/promptfooconfig.yaml

# Python
__pycache__/
*.pyc
.venv/
/use/
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# Node
node_modules/
npm-debug.log

# Test artifacts
.test-output/

# Build artifacts
/build/
/dist/

# Editors
.vscode/
.idea/

# Claude session state
.claude/handoff/

# Documentation working artifacts
docs/superpowers/

# Stray scaffolding directory (regenerated by old harness scripts)
/.lola/

# examples/ contains per-test-set .lola-eval/ dirs. Only the out/ subdirectory
# (runs.db, workspace/, reports/, junit.xml, last-run.json) is regenerable.
/examples/*/.lola-eval/out/

# Committing eval history is a per-target decision; the examples never do.
/examples/*/.lola-eval/ledger.jsonl
/examples/*/.lola-eval/snapshots/

# OS
.DS_Store

# Optional: project-local XDG state if user opts in via XDG_STATE_HOME=$PWD/.xdg-state
/.xdg-state/
/.xdg-cache/
/.xdg-config/
